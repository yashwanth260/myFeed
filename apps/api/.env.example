# Feedo API Environment Configuration Example
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
HOST=0.0.0.0

# Database (PostgreSQL + PostGIS)
DATABASE_URL="postgresql://feedo:feedo_pass@localhost:5432/feedo_db?schema=public&connection_limit=25&pool_timeout=20"
DATABASE_CONNECTION_LIMIT=25
DATABASE_POOL_TIMEOUT=20
DATABASE_IDLE_TIMEOUT=10

# Dynamic Catalog (MongoDB)
MONGODB_URI="mongodb://localhost:27017/feedo_catalog"
MONGODB_DB_NAME="feedo_catalog"
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=50
MONGODB_CONNECT_TIMEOUT_MS=10000

# Redis (Pub/Sub, Caching & BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"
REDIS_DB=0

# Security & JWT Secrets
JWT_SECRET="feedo_super_secret_jwt_dev_key_2026_secure"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="feedo_super_secret_refresh_dev_key_2026_secure"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=10

# CORS & Rate Limiting
CORS_ORIGINS="http://localhost:3000,http://localhost:8080,http://localhost:8081,http://localhost:8082,http://localhost:8083,http://localhost:8084,http://localhost:8085"
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Payments (Razorpay Integration - Test Mode Placeholder)
RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="rzp_test_placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="rzp_test_webhook_secret"
