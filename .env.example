# =================================================================
# CraveCart Production & Development Environment Configuration
# =================================================================

# 1. APPLICATION & SERVER
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_NAME=CraveCart
APP_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:8083,http://localhost:8084

# 2. DATABASE (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cravecart?schema=public

# 3. AUTHENTICATION & SECURITY
# Generate cryptographically secure 256-bit secrets for production
JWT_ACCESS_SECRET=cravecart-ultra-secure-jwt-access-secret-key-32chars
JWT_REFRESH_SECRET=cravecart-ultra-secure-jwt-refresh-secret-key-32chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
PASSWORD_SALT_ROUNDS=10

# 4. REDIS (Caching, BullMQ Background Processing, Socket.IO Adapter)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 5. PAYMENT GATEWAY (Razorpay India)
# Use 'rzp_test_...' keys for testing; use 'rzp_live_...' only in production
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_CravecartSandboxKey123
RAZORPAY_KEY_ID=rzp_test_CravecartSandboxKey123
RAZORPAY_KEY_SECRET=CravecartSandboxSecret456Key
RAZORPAY_WEBHOOK_SECRET=CravecartWebhookSecretHmac789

# 6. SHARED SUPABASE (Optional managed backend configuration)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 7. MAPS & LOCATION SERVICES (Google Maps Platform)
GOOGLE_MAPS_API_KEY=your_sandbox_google_maps_api_key_example
DEFAULT_LATITUDE=12.9716
DEFAULT_LONGITUDE=77.5946
MAX_DELIVERY_RADIUS_KM=12.0

# 8. NOTIFICATIONS & COMMUNICATIONS
SMS_PROVIDER=msg91 # msg91, twilio, or console
MSG91_AUTH_KEY=
EMAIL_FROM="orders@cravecart.in"
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=

# 9. CLOUD ASSET STORAGE (Cloudinary / AWS S3)
STORAGE_PROVIDER=local # local, cloudinary, or s3
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 10. PLATFORM BUSINESS RULES (All Monetary Values in Paise: 100 paise = ₹1)
BASE_DELIVERY_FEE_PAISE=4000
FREE_DELIVERY_THRESHOLD_PAISE=50000
SERVICE_FEE_PAISE=1500
GST_TAX_RATE=0.05
RESTAURANT_COMMISSION_PERCENT=15.0
DRIVER_BASE_PAYOUT_PAISE=6500
