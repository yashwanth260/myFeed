{
  "name": "cravecart-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node scripts/start-web-servers.js",
    "start:web": "node scripts/start-web-servers.js",
    "start:api": "node apps/api/dist/main.js",
    "build:api": "tsc --project apps/api/tsconfig.json",
    "start:customer": "npm --prefix apps/customer start",
    "start:restaurant": "npm --prefix apps/restaurant start",
    "start:delivery": "npm --prefix apps/delivery start",
    "flutter:customer": "cd apps/customer_flutter && flutter run",
    "flutter:restaurant": "cd apps/restaurant_flutter && flutter run",
    "flutter:delivery": "cd apps/delivery_flutter && flutter run",
    "test": "node scripts/run-tests.js",
    "test:e2e": "node -r ts-node/register scripts/e2e-smoke.ts",
    "typecheck": "tsc --build --noEmit",
    "lint": "eslint .",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "prisma:generate": "prisma generate",
    "prisma:seed": "node scripts/seed-all.js",
    "db:setup": "prisma generate && prisma db push",
    "db:seed": "node scripts/seed-all.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/passport": "^12.0.1",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/platform-socket.io": "^12.6.0",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/websockets": "^12.6.0",
    "@prisma/client": "5.22.0",
    "bcryptjs": "^3.0.3",
    "border-beam": "^1.4.1",
    "bullmq": "^6.7.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "es-abstract": "^1.24.2",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.9.1",
    "motion": "^14.9.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "5.22.0",
    "razorpay": "^2.9.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "tailwind-merge": "^3.7.0",
    "ts-node": "^10.9.2"
  }
}
