// CraveCart Enterprise Production Prisma Schema
// PostgreSQL Relational Architecture with strict integer paise financial modeling

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  RESTAURANT_OWNER
  RESTAURANT_STAFF
  DELIVERY_PARTNER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING_APPROVAL
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  REJECTED
  CANCELLED
  PAYMENT_FAILED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  COD
}

enum DiscountType {
  FLAT
  PERCENTAGE
}

enum AssignmentStatus {
  OFFERED
  ACCEPTED
  PICKED_UP
  COMPLETED
  REJECTED
}

enum DietaryType {
  VEG
  NON_VEG
  EGG
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ==========================================
// 1. IDENTITY & ACCESS CONTROL
// ==========================================
model User {
  id             String         @id @default(uuid())
  email          String         @unique
  phone          String         @unique
  fullName       String
  passwordHash   String
  avatarUrl      String?
  accountStatus  AccountStatus  @default(ACTIVE)
  role           Role           @default(CUSTOMER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relationships
  addresses             Address[]
  cart                  Cart?
  orders                Order[]                 @relation("CustomerOrders")
  restaurantMemberships RestaurantMember[]
  deliveryAssignments   DeliveryAssignment[]   @relation("DriverAssignments")
  deliveryLocations     DeliveryLocation[]     @relation("DriverLocations")
  notifications         Notification[]
  reviews               Review[]
  auditLogs             AuditLog[]
  driverEarnings        DriverEarning[]
  disputes              DisputeTicket[]        @relation("CustomerDisputes")
  assignedDisputes      DisputeTicket[]        @relation("AdminAssignedDisputes")
  disputeMessages       DisputeMessage[]
  orderStatusChanges    OrderStatusHistory[]   @relation("ActorStatusChanges")
  couponRedemptions     CouponRedemption[]

  @@index([email])
  @@index([phone])
  @@index([role])
}

model Address {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                String   @default("Home") // Home, Work, Other
  fullAddress          String
  landmark             String?
  city                 String
  state                String
  postalCode           String
  latitude             Float?
  longitude            Float?
  deliveryInstructions String?
  isDefault            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
}

// ==========================================
// 2. RESTAURANTS & OPERATIONAL PROFILE
// ==========================================
model Restaurant {
  id                         String   @id @default(uuid())
  name                       String
  slug                       String   @unique
  description                String   @default("")
  logoUrl                    String   @default("")
  bannerUrl                  String   @default("")
  address                    String
  city                       String
  state                      String
  postalCode                 String
  latitude                   Float
  longitude                  Float
  cuisineTypes               String[] @default([])
  openingTime                String   @default("08:00") // HH:mm format
  closingTime                String   @default("23:00")
  isApproved                 Boolean  @default(false)
  isActive                   Boolean  @default(true)
  isOpen                     Boolean  @default(true)
  minOrderAmountPaise        Int      @default(10000) // ₹100.00
  baseDeliveryFeePaise       Int      @default(4000)  // ₹40.00
  freeDeliveryThresholdPaise Int?     @default(50000) // Free delivery above ₹500
  packagingFeePaise          Int      @default(1500)  // ₹15.00
  commissionRatePercent      Float    @default(15.0)  // 15% platform fee
  estimatedPrepTimeMinutes   Int      @default(25)
  rating                     Float    @default(4.5)
  ratingCount                Int      @default(0)
  fssaiLicenseNumber         String?
  bankAccountNumber          String?
  bankIfscCode               String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  // Relationships
  members         RestaurantMember[]
  categories      MenuCategory[]
  menuItems       MenuItem[]
  carts           Cart[]
  orders          Order[]
  settlements     RestaurantSettlement[]
  reviews         Review[]

  @@index([city])
  @@index([isApproved, isActive, isOpen])
  @@index([latitude, longitude])
}

model RestaurantMember {
  id             String     @id @default(uuid())
  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String     @default("owner") // owner, manager, staff
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())

  @@unique([restaurantId, userId])
  @@index([userId])
}

// ==========================================
// 3. MENU & CATALOG
// ==========================================
model MenuCategory {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())

  menuItems MenuItem[]

  @@index([restaurantId])
}

model MenuItem {
  id            String       @id @default(uuid())
  restaurantId  String
  restaurant    Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId    String
  category      MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name          String
  description   String       @default("")
  pricePaise    Int          // Price strictly in integer paise (₹349.00 -> 34900)
  imageUrl      String       @default("")
  dietaryType   DietaryType  @default(VEG)
  isAvailable   Boolean      @default(true)
  isRecommended Boolean      @default(false)
  displayOrder  Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  customizationGroups ItemCustomizationGroup[]
  cartItems           CartItem[]
  orderItems          OrderItem[]

  @@index([restaurantId])
  @@index([categoryId])
  @@index([isAvailable])
}

model ItemCustomizationGroup {
  id         String   @id @default(uuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String   // e.g. "Choose Portion Size", "Extra Addons"
  minSelect  Int      @default(0)
  maxSelect  Int      @default(1)
  isRequired Boolean  @default(false)
  createdAt  DateTime @default(now())

  options ItemCustomizationOption[]

  @@index([menuItemId])
}

model ItemCustomizationOption {
  id          String                 @id @default(uuid())
  groupId     String
  group       ItemCustomizationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name        String                 // e.g. "Extra Cheddar Cheese"
  pricePaise  Int                    @default(0)
  isAvailable Boolean                @default(true)
  createdAt   DateTime               @default(now())

  @@index([groupId])
}

// ==========================================
// 4. CART & SERVER-AUTHORITATIVE PRICING
// ==========================================
model Cart {
  id           String      @id @default(uuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  couponCode   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  items CartItem[]
}

model CartItem {
  id             String   @id @default(uuid())
  cartId         String
  cart           Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menuItemId     String
  menuItem       MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  quantity       Int      @default(1)
  customizations Json     @default("[]") // Array of { optionId, name, pricePaise }
  unitPricePaise Int
  lineTotalPaise Int
  createdAt      DateTime @default(now())

  @@index([cartId])
  @@index([menuItemId])
}

// ==========================================
// 5. ORDERS & FINANCIAL ENGINE
// ==========================================
model Order {
  id                    String        @id @default(uuid())
  orderNumber           String        @unique // e.g. "CC-20261104-9481"
  userId                String
  user                  User          @relation("CustomerOrders", fields: [userId], references: [id], onDelete: Restrict)
  restaurantId          String
  restaurant            Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  orderStatus           OrderStatus   @default(PENDING)
  paymentStatus         PaymentStatus @default(PENDING)
  paymentMethod         PaymentMethod @default(RAZORPAY)

  // Address Snapshot at the exact moment of order placement
  addressSnapshot       Json

  // Financial Breakdown (All Integer Paise)
  subtotalPaise         Int           // Sum of items & item customizations
  discountPaise         Int           @default(0)
  deliveryFeePaise      Int           @default(0)
  serviceFeePaise       Int           @default(1500) // ₹15.00
  taxPaise              Int           @default(0)    // 5% GST on taxable base
  finalTotalPaise       Int           // Exact grand total charged

  couponCode            String?
  cancellationReason    String?
  rejectionReason       String?
  estimatedDeliveryTime DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  // Relationships
  items                 OrderItem[]
  payments              Payment[]
  statusHistory         OrderStatusHistory[]
  deliveryAssignment    DeliveryAssignment?
  deliveryLocations     DeliveryLocation[]
  review                Review?
  disputes              DisputeTicket[]
  couponRedemptions     CouponRedemption[]

  @@index([userId])
  @@index([restaurantId])
  @@index([orderStatus])
  @@index([createdAt])
}

model OrderItem {
  id                    String   @id @default(uuid())
  orderId               String
  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId            String
  menuItem              MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  name                  String
  unitPricePaise        Int
  quantity              Int
  customizations        Json     @default("[]")
  lineTotalPaise        Int
  createdAt             DateTime @default(now())

  @@index([orderId])
}

model OrderStatusHistory {
  id             String       @id @default(uuid())
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  previousStatus OrderStatus?
  nextStatus     OrderStatus
  actorId        String
  actor          User         @relation("ActorStatusChanges", fields: [actorId], references: [id], onDelete: Restrict)
  note           String?
  createdAt      DateTime     @default(now())

  @@index([orderId])
}

// ==========================================
// 6. PAYMENTS & WEBHOOK IDEMPOTENCY
// ==========================================
model Payment {
  id                   String        @id @default(uuid())
  orderId              String
  order                Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider             PaymentMethod @default(RAZORPAY)
  providerOrderId      String?       // Razorpay order_id
  providerPaymentId    String?       // Razorpay payment_id
  providerSignature    String?       // Razorpay signature
  amountPaise          Int
  currency             String        @default("INR")
  status               PaymentStatus @default(PENDING)
  verificationMetadata Json?         @default("{}")
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([orderId])
  @@index([providerOrderId])
}

model WebhookEvent {
  id             String   @id @default(uuid())
  eventId        String   @unique // Provider event id (e.g. event_id from Razorpay webhook)
  eventType      String   // e.g. "payment.captured", "payment.failed"
  payload        Json
  signature      String?
  processedAt    DateTime @default(now())
  status         String   @default("PROCESSED") // PROCESSED, FAILED, IGNORED

  @@index([eventId])
}

// ==========================================
// 7. COUPONS & PROMOTIONS
// ==========================================
model Coupon {
  id                 String       @id @default(uuid())
  code               String       @unique
  description        String       @default("")
  discountType       DiscountType @default(PERCENTAGE)
  discountValue      Int          // Flat paise or percentage points (e.g. 50 for 50%)
  maxDiscountPaise   Int?         // Max discount ceiling in paise
  minOrderAmountPaise Int         @default(0)
  validFrom          DateTime     @default(now())
  validUntil         DateTime
  usageLimitPerUser  Int          @default(1)
  totalUsageLimit    Int?
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())

  redemptions CouponRedemption[]

  @@index([code])
  @@index([isActive])
}

model CouponRedemption {
  id                  String   @id @default(uuid())
  couponId            String
  coupon              Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discountAppliedPaise Int
  createdAt           DateTime @default(now())

  @@unique([couponId, orderId])
  @@index([userId])
}

// ==========================================
// 8. DELIVERY DISPATCH & LIVE TRACKING
// ==========================================
model DeliveryAssignment {
  id                String           @id @default(uuid())
  orderId           String           @unique
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driverId          String
  driver            User             @relation("DriverAssignments", fields: [driverId], references: [id], onDelete: Restrict)
  status            AssignmentStatus @default(OFFERED)
  offeredAt         DateTime         @default(now())
  acceptedAt        DateTime?
  pickedUpAt        DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  estimatedDistanceKm Float          @default(3.5)
  payoutAmountPaise Int              @default(6500) // ₹65.00 base rider payout
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([driverId])
  @@index([status])
}

model DeliveryLocation {
  id        String   @id @default(uuid())
  driverId  String
  driver    User     @relation("DriverLocations", fields: [driverId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  heading   Float?   @default(0.0)
  speed     Float?   @default(0.0)
  createdAt DateTime @default(now())

  @@index([driverId])
  @@index([orderId])
  @@index([createdAt])
}

// ==========================================
// 9. FINANCIAL LEDGER & SETTLEMENTS
// ==========================================
model RestaurantSettlement {
  id                    String     @id @default(uuid())
  restaurantId          String
  restaurant            Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  periodStart           DateTime
  periodEnd             DateTime
  grossSalesPaise       Int
  platformCommissionPaise Int
  netPayoutPaise        Int
  settlementStatus      String     @default("PENDING") // PENDING, PROCESSING, SETTLED
  payoutReference       String?
  settledAt             DateTime?
  createdAt             DateTime   @default(now())

  @@index([restaurantId])
}

model DriverEarning {
  id             String   @id @default(uuid())
  driverId       String
  driver         User     @relation(fields: [driverId], references: [id], onDelete: Restrict)
  orderId        String
  tripDistanceKm Float
  amountPaise    Int      // ₹65.00 base + incentives
  tipPaise       Int      @default(0)
  status         String   @default("CREDITED") // CREDITED, PAID_OUT
  createdAt      DateTime @default(now())

  @@index([driverId])
}

// ==========================================
// 10. REVIEWS & QUALITY
// ==========================================
model Review {
  id           String     @id @default(uuid())
  orderId      String     @unique
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  rating       Int        // 1 to 5 stars
  comment      String?
  createdAt    DateTime   @default(now())

  @@index([restaurantId])
  @@index([userId])
}

// ==========================================
// 11. CUSTOMER SUPPORT & DISPUTES
// ==========================================
model DisputeTicket {
  id             String         @id @default(uuid())
  ticketNumber   String         @unique // e.g. "DSP-90412"
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId     String
  customer       User           @relation("CustomerDisputes", fields: [customerId], references: [id], onDelete: Restrict)
  assignedToId   String?
  assignedAdmin  User?          @relation("AdminAssignedDisputes", fields: [assignedToId], references: [id], onDelete: SetNull)
  category       String         // "MISSING_ITEM", "COLD_FOOD", "LATE_DELIVERY", "PAYMENT_ISSUE"
  status         TicketStatus   @default(OPEN)
  resolution     String?
  refundPaise    Int?           @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  messages DisputeMessage[]

  @@index([orderId])
  @@index([customerId])
  @@index([status])
}

model DisputeMessage {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    DisputeTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User          @relation(fields: [senderId], references: [id], onDelete: Restrict)
  message   String
  createdAt DateTime      @default(now())

  @@index([ticketId])
}

// ==========================================
// 12. NOTIFICATIONS & AUDIT LOGS
// ==========================================
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("ORDER_UPDATE")
  data      Json?    @default("{}")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String   // e.g. "APPROVE_RESTAURANT", "OVERRIDE_ORDER_STATUS", "PROCESS_REFUND"
  targetType String   // e.g. "RESTAURANT", "ORDER", "PAYMENT"
  targetId   String
  details    Json?    @default("{}")
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

